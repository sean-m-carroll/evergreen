{
  "name": "@4t2/evergreen",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "evergreen": "./bin/cli.mjs"
  },
  "scripts": {
    "cleanup": "node scripts/cleanup.mjs",
    "eslint:check": "eslint",
    "eslint:fix": "eslint --fix",
    "fix": "run-s eslint:fix prettier:fix",
    "lint": "run-s eslint:check prettier:check",
    "prettier:check": "prettier . '!**/*.md' --check",
    "prettier:fix": "prettier . '!**/*.md' --write",
    "test": "run-s lint test:unit cleanup",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "npm-check-updates": "23.1.0",
    "yargs": "18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.9",
    "vitest": "5.0.3"
  }
}
